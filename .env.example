# Slack bot token from api.slack.com/apps (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# Channel to read articles from. Channel ID (e.g. C0123456789) or name (e.g. #articles)
SLACK_CHANNEL=#articles

# Where to post the weekly summary. Defaults to SLACK_CHANNEL if omitted.
SLACK_SUMMARY_CHANNEL=#articles

# Path to the Google service account JSON key file.
# Locally: a file on disk. In GitHub Actions: written from a secret at
# runtime (see .github/workflows/weekly-summary.yml).
GOOGLE_CREDENTIALS_PATH=./service-account.json

# The Google Sheet's ID (from its URL: /spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=your-sheet-id-here

# Tab name within the sheet to write to
GOOGLE_SHEET_TAB=Articles

# How many days back to look each run
DAYS_BACK=7
